generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  plan      String   @default("free") // "free" | "pro"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  url         String
  status      String   @default("pending") // "pending" | "crawling" | "done" | "error"
  analysisId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  crawlData   CrawlCache? @relation(fields: [url], references: [url])

  @@index([userId])
}

// Global cache — shared across all users. Same URL is never crawled twice.
model CrawlCache {
  id        String   @id @default(cuid())
  url       String   @unique
  data      String   // JSON blob of AnalysisResult
  crawledAt DateTime @default(now())

  projects  Project[]
}
