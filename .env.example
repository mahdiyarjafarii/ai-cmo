# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Alternative: Use Claude
# LLM_PROVIDER=claude
# CLAUDE_API_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Crawling
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Search
TAVILY_API_KEY=your_tavily_api_key_here

# Logging
LOG_LEVEL=info

# Output
OUTPUT_DIR=./output

# Google APIs (optional — enables real PageSpeed data in Analytics panel)
# Get your key: https://console.cloud.google.com → Enable "PageSpeed Insights API"
GOOGLE_PAGESPEED_KEY=your_google_api_key_here
